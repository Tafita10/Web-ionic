# ============================================
# CONFIGURATION APPLICATION
# ============================================
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ============================================
# BASE DE DONNÉES POSTGRESQL
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webrojo_db
DB_USER=webrojo_user
DB_PASSWORD=webrojo_password_2026
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEZONE=+03:00

# ============================================
# JWT (JSON WEB TOKENS)
# ============================================
# Secret pour les access tokens (CHANGER EN PRODUCTION)
JWT_SECRET=changez_ce_secret_jwt_en_production_utilisez_une_chaine_aleatoire_longue

# Durée de vie du access token (2 heures par défaut)
JWT_EXPIRES_IN=2h

# Secret pour les refresh tokens (CHANGER EN PRODUCTION)
JWT_REFRESH_SECRET=changez_ce_secret_refresh_en_production_utilisez_une_chaine_aleatoire_longue

# Durée de vie du refresh token (7 jours par défaut)
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# SÉCURITÉ
# ============================================
# Nombre maximum de tentatives de connexion avant blocage
MAX_LOGIN_ATTEMPTS=3

# Coût BCrypt pour hash des mots de passe (12 recommandé)
BCRYPT_ROUNDS=12

# Durée de vie des sessions en minutes (120 = 2 heures)
SESSION_DURATION_MINUTES=120

# Durée de validité du token de vérification email (24h)
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# Durée de validité du token de réinitialisation mot de passe (1h)
PASSWORD_RESET_EXPIRY_HOURS=1

# ============================================
# RATE LIMITING
# ============================================
# Connexion: nombre de tentatives par fenêtre de temps
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# Inscription: nombre de tentatives par fenêtre
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW_MINUTES=60

# API générale: nombre de requêtes par fenêtre
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MINUTES=15

# ============================================
# FIREBASE (OPTIONNEL - pour synchronisation mobile)
# ============================================
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=votre-projet-firebase-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nVOTRE_CLE_PRIVEE_ICI\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@votre-projet.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://votre-projet.firebaseio.com

# ============================================
# EMAIL (SMTP - pour vérification et réinitialisation)
# ============================================
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-application
EMAIL_FROM=noreply@webrojo.mg
EMAIL_FROM_NAME=Web Rojo

# ============================================
# REDIS (OPTIONNEL - pour cache et rate limiting)
# ============================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=webrojo_redis_password
REDIS_DB=0

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
# Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:8080,http://localhost:3001,http://localhost:4200
CORS_CREDENTIALS=true

# ============================================
# LOGGING
# ============================================
# Niveau de log: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=debug

# Activer les logs dans des fichiers
LOG_TO_FILE=true

# Répertoire des logs
LOG_DIR=./logs

# ============================================
# UPLOADS (PHOTOS DE PROFIL)
# ============================================
UPLOAD_ENABLED=true
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/jpg

# ============================================
# APPLICATION WEB & MOBILE
# ============================================
# URL de l'application web (pour emails de vérification)
WEB_APP_URL=http://localhost:8080

# URL de deep linking pour l'app mobile
MOBILE_APP_SCHEME=webrojo://

# ============================================
# ENVIRONNEMENT DE DÉVELOPPEMENT
# ============================================
# Afficher les erreurs détaillées en développement
DEBUG=true

# Activer le rechargement automatique
HOT_RELOAD=true

# Désactiver HTTPS en développement
DISABLE_HTTPS=true

# ============================================
# MONITORING & SANTÉ
# ============================================
# Endpoint de health check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/api/health

# ============================================
# TIMEZONE
# ============================================
# Timezone de Madagascar (UTC+3)
TZ=Indian/Antananarivo
