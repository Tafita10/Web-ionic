{
	"info": {
		"_postman_id": "webrojo-api-collection",
		"name": "WebRojo API",
		"description": "Collection Postman complète pour tester l'API WebRojo - Gestion des signalements routiers à Antananarivo.\n\n## Configuration\n1. Importer cette collection dans Postman\n2. Les variables `base_url` et `token` sont gérées automatiquement\n3. Commencer par **Login Manager** pour obtenir le token\n4. Le token est auto-injecté dans toutes les requêtes authentifiées",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:3000/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "refresh_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "🔐 Authentification",
			"item": [
				{
					"name": "Login Manager",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('token', json.jetonAcces || json.token);",
									"    pm.collectionVariables.set('refresh_token', json.jetonRefresh || json.refreshToken);",
									"    pm.test('Login réussi', function() {",
									"        pm.expect(json.utilisateur).to.exist;",
									"        pm.expect(json.utilisateur.id_type_utilisateur).to.eql(1);",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"identifiant\": \"manager\",\n    \"mot_de_passe\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						},
						"description": "Connexion en tant que Manager. Le token JWT est automatiquement sauvegardé dans les variables de collection."
					}
				},
				{
					"name": "Login Utilisateur",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('token', json.jetonAcces || json.token);",
									"    pm.collectionVariables.set('refresh_token', json.jetonRefresh || json.refreshToken);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"identifiant\": \"manager@gmail.com\",\n    \"mot_de_passe\": \"manda123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Inscription",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nom_complet\": \"Jean Rakoto\",\n    \"email\": \"jean@webrojo.mg\",\n    \"nom_utilisateur\": \"jrakoto\",\n    \"mot_de_passe\": \"MotDePasse123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": ["{{base_url}}"],
							"path": ["auth", "register"]
						}
					}
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('token', json.jetonAcces);",
									"    pm.collectionVariables.set('refresh_token', json.jetonRefresh);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/refresh",
							"host": ["{{base_url}}"],
							"path": ["auth", "refresh"]
						}
					}
				},
				{
					"name": "Profil (me)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": ["{{base_url}}"],
							"path": ["auth", "me"]
						}
					}
				},
				{
					"name": "Déconnexion",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{base_url}}/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["auth", "logout"]
						}
					}
				},
				{
					"name": "Débloquer utilisateur (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id_utilisateur\": 5\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/unlock-user",
							"host": ["{{base_url}}"],
							"path": ["auth", "unlock-user"]
						}
					}
				}
			]
		},
