# ═══════════════════════════════════════════════════════════════════
# VISITOR MODULE CONFIGURATION
# Configuration spécifique au Module Web Visiteur
# ═══════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────
# 🎨 THÈME ET COULEURS
# ──────────────────────────────────────────────────────────────────

# Couleur primaire (bleu indigo par défaut)
PRIMARY_COLOR=#667eea

# Couleur secondaire (violet par défaut)
SECONDARY_COLOR=#764ba2

# Couleur succès (vert)
SUCCESS_COLOR=#00AA00

# Couleur avertissement (orange)
WARNING_COLOR=#FFA500

# Couleur erreur (rouge)
ERROR_COLOR=#FF0000

# Couleur informations (gris)
INFO_COLOR=#808080

# ──────────────────────────────────────────────────────────────────
# 🗺️ CONFIGURATION CARTE
# ──────────────────────────────────────────────────────────────────

# Latitude initiale (Antananarivo par défaut)
VITE_MAP_CENTER_LAT=-18.8792

# Longitude initiale
VITE_MAP_CENTER_LNG=47.5079

# Zoom initial
VITE_MAP_INITIAL_ZOOM=12

# Zoom auto-fit
VITE_MAP_AUTO_FIT=true

# Padding pour auto-fit (pixels)
VITE_MAP_FIT_PADDING=50

# Min zoom autorisé
VITE_MAP_MIN_ZOOM=10

# Max zoom autorisé
VITE_MAP_MAX_ZOOM=18

# Provider tiles (openstreetmap, mapbox, google)
VITE_MAP_PROVIDER=openstreetmap

# ──────────────────────────────────────────────────────────────────
# 📊 STATISTIQUES
# ──────────────────────────────────────────────────────────────────

# Afficher les statistiques
VITE_SHOW_STATS=true

# Afficher l'avancement en %
VITE_SHOW_PROGRESS=true

# Afficher les mini-badges
VITE_SHOW_BADGES=true

# ──────────────────────────────────────────────────────────────────
# 📋 TABLEAU ET PAGINATION
# ──────────────────────────────────────────────────────────────────

# Nombre d'items par page
VITE_ITEMS_PER_PAGE=100

# Afficher la pagination
VITE_SHOW_PAGINATION=true

# Hauteur max du tableau (px)
VITE_TABLE_MAX_HEIGHT=600

# Afficher le scroll horizontal
VITE_TABLE_SCROLLABLE=true

# ──────────────────────────────────────────────────────────────────
# 🔍 FILTRES
# ──────────────────────────────────────────────────────────────────

# Afficher les filtres
VITE_SHOW_FILTERS=true

# Filtrer par statut
VITE_FILTER_BY_STATUS=true

# Filtrer par gravité
VITE_FILTER_BY_SEVERITY=true

# Filtrer par ville
VITE_FILTER_BY_CITY=true

# Filtrer par date (futur)
VITE_FILTER_BY_DATE=false

# Filtrer par budget (futur)
VITE_FILTER_BY_BUDGET=false

# ──────────────────────────────────────────────────────────────────
# 📸 PHOTOS
# ──────────────────────────────────────────────────────────────────

# Afficher les photos
VITE_SHOW_PHOTOS=true

# Max photos à charger
VITE_MAX_PHOTOS=10

# Résolution photos (thumbnail, medium, full)
VITE_PHOTO_RESOLUTION=medium

# Lazy load images
VITE_LAZY_LOAD_IMAGES=true

# ──────────────────────────────────────────────────────────────────
# 📱 RESPONSIVE
# ──────────────────────────────────────────────────────────────────

# Breakpoint mobile (px)
VITE_BREAKPOINT_MOBILE=480

# Breakpoint tablet (px)
VITE_BREAKPOINT_TABLET=768

# Breakpoint desktop (px)
VITE_BREAKPOINT_DESKTOP=1200

# ──────────────────────────────────────────────────────────────────
# ⚡ PERFORMANCE
# ──────────────────────────────────────────────────────────────────

# Cache données (ms)
VITE_CACHE_DURATION=300000

# Timeout requêtes API (ms)
VITE_API_TIMEOUT=5000

# Activer les animations
VITE_ENABLE_ANIMATIONS=true

# Durée animations (ms)
VITE_ANIMATION_DURATION=300

# ──────────────────────────────────────────────────────────────────
# 🔐 SÉCURITÉ
# ──────────────────────────────────────────────────────────────────

# Afficher les emails
VITE_SHOW_EMAILS=true

# Afficher les téléphones
VITE_SHOW_PHONES=true

# Afficher les noms des créateurs
VITE_SHOW_CREATOR_NAMES=true

# Max images uploadables
VITE_MAX_IMAGE_SIZE=5242880

# ──────────────────────────────────────────────────────────────────
# 🌐 LOCALISATION
# ──────────────────────────────────────────────────────────────────

# Langue (fr, en, mg)
VITE_LANGUAGE=fr

# Format date (dd/mm/yyyy, mm/dd/yyyy)
VITE_DATE_FORMAT=dd/mm/yyyy

# Format devise (Ar pour Ariary)
VITE_CURRENCY=Ar

# Format nombre (fr, en)
VITE_NUMBER_FORMAT=fr

# ──────────────────────────────────────────────────────────────────
# 📢 NOTIFICATIONS
# ──────────────────────────────────────────────────────────────────

# Afficher les notifications
VITE_SHOW_NOTIFICATIONS=true

# Durée notifications (ms)
VITE_NOTIFICATION_DURATION=3000

# Sons notifications
VITE_NOTIFICATION_SOUND=false

# ──────────────────────────────────────────────────────────────────
# 🔌 API ENDPOINTS
# ──────────────────────────────────────────────────────────────────

# Base URL API
VITE_API_URL=http://localhost:3000/api

# Endpoint stats
VITE_API_STATS_ENDPOINT=/visitor/stats

# Endpoint signalements
VITE_API_SIGNALEMENTS_ENDPOINT=/visitor/signalements

# Endpoint détail
VITE_API_DETAIL_ENDPOINT=/visitor/signalements

# Endpoint map
VITE_API_MAP_ENDPOINT=/visitor/map-data

# Endpoint villes
VITE_API_VILLES_ENDPOINT=/visitor/villes

# ──────────────────────────────────────────────────────────────────
# 📊 ANALYTICS (optionnel)
# ──────────────────────────────────────────────────────────────────

# Activer analytics
VITE_ENABLE_ANALYTICS=false

# Google Analytics ID
VITE_GA_ID=GA-XXXXX

# ──────────────────────────────────────────────────────────────────
# 🐛 DEBUG
# ──────────────────────────────────────────────────────────────────

# Mode debug
VITE_DEBUG=false

# Logs API
VITE_DEBUG_API=false

# Logs composants
VITE_DEBUG_COMPONENTS=false

# Logs performances
VITE_DEBUG_PERFORMANCE=false

# ═══════════════════════════════════════════════════════════════════
# NOTES IMPORTANTES
# ═══════════════════════════════════════════════════════════════════

# 1. FICHIER OPTIONNEL
#    Vous pouvez utiliser ce fichier pour personnaliser le module
#    ou laisser les valeurs par défaut dans le code
#
# 2. VALEURS PAR DÉFAUT
#    Les valeurs dans le code sont suffisantes pour une utilisation
#    standard. Ce fichier est pour les personnalisations avancées.
#
# 3. DÉVELOPPEMENT vs PRODUCTION
#    Copier ce fichier en:
#    - .env.development (développement)
#    - .env.production (production)
#
# 4. COULEURS
#    Format hexadécimal: #RRGGBB
#    Ex: #667eea (bleu indigo)
#
# 5. COORDONNÉES
#    Latitude: -90 à 90
#    Longitude: -180 à 180
#    Antananarivo: -18.8792, 47.5079
#
# 6. TEMPS (ms = millisecondes)
#    1000 ms = 1 secondes
#    300000 ms = 5 minutes
#
# 7. BOOLÉENS
#    true / false (lowercase, pas de guillemets)
#
# 8. NOMBRES
#    Sans guillemets, sans unités
#    Ex: VITE_CACHE_DURATION=300000
#
# ═══════════════════════════════════════════════════════════════════
