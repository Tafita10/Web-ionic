# Configuration du serveur
PORT=3000
NODE_ENV=development

# Configuration PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ionic_db
DB_USER=ionic_user
DB_PASSWORD=ionic_password

# Configuration Firebase Admin SDK
# Téléchargez votre fichier de clé privée depuis Firebase Console
# puis copiez le chemin ici
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# JWT Secret (pour les tokens locaux)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Mode de fonctionnement par défaut (firebase ou local)
DEFAULT_MODE=firebase
