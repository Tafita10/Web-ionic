# Backend Environment Variables
# Copiez ce fichier en .env et remplissez les valeurs

# Port du serveur
PORT=3000

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=ionic_app

# JWT Secret (utilisé pour les tokens)
JWT_SECRET=your-secret-key-change-this-in-production

# Firebase Service Account (optionnel)
# Si non défini, utilise backend/src/config/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/firebase-service-account.json

# Mode de développement
NODE_ENV=development
